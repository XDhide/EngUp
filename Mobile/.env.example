# Địa chỉ API của Backend (bắt buộc nếu tự động dò IP không đúng).
# - Điện thoại thật / Expo Go: dùng IP LAN của máy chạy Backend, ví dụ http://192.168.1.10:5000/api
# - Android emulator: http://10.0.2.2:5000/api
# - iOS simulator / web: http://localhost:5000/api
# Nếu để trống, app tự lấy IP của máy đang chạy `expo start` (cổng 5000).
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Expo projectId để lấy push token (chạy `npx eas init` để có; dạng UUID).
# Bắt buộc để nhận thông báo đẩy trên bản development build / điện thoại thật.
# Lưu ý: Expo Go trên Android KHÔNG nhận được push (từ SDK 53), cần dev build.
EXPO_PUBLIC_EAS_PROJECT_ID=
